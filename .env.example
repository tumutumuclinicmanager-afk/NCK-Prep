# GEMINI_API_KEY: Required for Gemini API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Stripe Payment Credentials (for US / International Card Payments)
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Safaricom M-Pesa Merchant Credentials & Payplus Gateway
MPESA_TILL_NUMBER=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Payplus M-Pesa Integration Credentials
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_ENDPOINT=https://api.payplus.co.ke/v1/stkpush

